# Environment Configuration for Bol.com Outreach Platform

# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
# For Railway, use: /data/bol-outreach.db (persistent volume mount)
# For local dev: ./data/bol-outreach.db
DATABASE_PATH=./data/bol-outreach.db

# Optional: AdsPower API Configuration
# If using AdsPower for multi-profile outreach
ADSPOWER_API_HOST=95.217.224.154
ADSPOWER_API_PORT=50325
ADSPOWER_API_KEY=your_api_key_here

# Rate limiting: max messages per hour per profile
ADSPOWER_RATE_LIMIT=5
# Business hours enforcement (Mon-Sat, 9AM-8PM GMT+1)
BUSINESS_HOURS_ENABLED=true
BUSINESS_HOURS_TIMEZONE=Europe/Amsterdam
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=20
BUSINESS_HOURS_ALLOWED_DAYS=1,2,3,4,5,6

# Optional: Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Bol.com Outreach <noreply@yourdomain.com>

# Security
SESSION_SECRET=change-this-to-a-random-string-in-production

# Logging
LOG_LEVEL=info
